            <rosparam command="load" file="$(find ts6_bluerov2_perception)/config/ekf_params_with_fiducial.yaml" unless="$(arg three_dimension)"/>
        </node>
    </group> -->

    <!-- <group unless="$(arg fiducial_correction)">
        <node pkg="robot_localization" type="ekf_localization_node" name="ekf_state_estimator" clear_params="true">
            <rosparam command="load" file="$(find ts6_bluerov2_perception)/config/ekf_params_imu_only_3d.yaml" if="$(arg three_dimension)"/>
            <rosparam command="load" file="$(find ts6_bluerov2_perception)/config/ekf_params_imu_only.yaml" unless="$(arg three_dimension)"/>
        </node>
    </group> -->

    <node pkg="bruce_slam" type="ground_truth_node.py" name="ground_truth_node" clear_params="true"/>

    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_state_estimator" clear_params="true">
        <rosparam command="load" file="$(find bruce_slam)/config/ekf_config/ekf_params_imu_only_3d.yaml" if="$(arg three_dimension)"/>
        <!-- <rosparam command="load" file="$(find bruce_slam)/config/ekf_config/ekf_params_imu_only.yaml" unless="$(arg three_dimension)"/> -->
        <rosparam command="load" file="/home/ubuntu/34763-autonomous-marine-robotics/Training_Sessions/TS6_Perception/ts6_ws/src/sonar-SLAM/bruce_slam/config/ekf_config/ekf_params_imu_only.yaml" unless="$(arg three_dimension)"/>
    </node>
      
    <!-- Start RViz  -->
    <node if="$(arg rviz)" type="rviz" name="rviz" pkg="rviz" args="-d $(find bruce_slam)/rviz/test.rviz" />
    
</launch>
