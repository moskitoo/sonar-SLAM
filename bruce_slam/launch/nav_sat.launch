<launch>

  <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform_node" respawn="true">

    <param name="magnetic_declination_radians" value="0"/>

    <param name="yaw_offset" value="0"/>

    <remap from="/imu/data" to="/bluerov2/mavros/imu/data" />
    <remap from="/gps/fix" to="/bluerov2/mavros/global_position/global" />
    <remap from="/odometry/filtered" to="/bluerov2/mavros/local_position/odom" />

  </node>

</launch>